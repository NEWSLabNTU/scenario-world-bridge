				<GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="79955" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction>
				<GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="80017" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction>
				<GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="80075" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction>
				<GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="80137" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction>
				<GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="80193" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction>
				<Private entityRef="ego">
					<PrivateAction>
