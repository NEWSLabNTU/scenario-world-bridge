		</Init>
		<Story name="ntu_loop">
			<Act name="drive_act">
				<ManeuverGroup maximumExecutionCount="1" name="ego_maneuvers">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="ego" />
					</Actors>
					<Maneuver name="end_conditions">
						<Event name="success" priority="parallel">
							<Action name="exit_success">
								<UserDefinedAction>
									<CustomCommandAction type="exitSuccess" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="reach_goal" delay="0" conditionEdge="none">
										<ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="5.0"><Position><WorldPosition x="52359.619" y="67657.274" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure">
								<UserDefinedAction>
									<CustomCommandAction type="exitFailure" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="timeout_condition" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="900.0" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="red_0_released" priority="parallel" maximumExecutionCount="1">
							<Action name="green_0"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="60991" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
							<Action name="clear_0"><GlobalAction><ParameterAction parameterRef="red_0"><SetAction value="0" /></ParameterAction></GlobalAction></Action>
							<StartTrigger><ConditionGroup>
								<Condition name="before_0" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="13.0"><Position><WorldPosition x="52047.929" y="67792.029" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition>
								<Condition name="stopped_0" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><StandStillCondition duration="3" /></EntityCondition></ByEntityCondition></Condition>
							</ConditionGroup></StartTrigger>
						</Event>
						<Event name="red_0_run" priority="parallel" maximumExecutionCount="1">
							<Action name="ran_red_0"><UserDefinedAction><CustomCommandAction type="exitFailure" /></UserDefinedAction></Action>
							<StartTrigger><ConditionGroup>
								<Condition name="beyond_0" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="8.0"><Position><WorldPosition x="52050.704" y="67805.751" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition>
								<Condition name="still_red_0" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="red_0" value="1" rule="equalTo" /></ByValueCondition></Condition>
							</ConditionGroup></StartTrigger>
						</Event>
						<Event name="red_1_released" priority="parallel" maximumExecutionCount="1">
							<Action name="green_1"><GlobalAction><InfrastructureAction><TrafficSignalAction><TrafficSignalStateAction name="52747" state="green" /></TrafficSignalAction></InfrastructureAction></GlobalAction></Action>
							<Action name="clear_1"><GlobalAction><ParameterAction parameterRef="red_1"><SetAction value="0" /></ParameterAction></GlobalAction></Action>
							<StartTrigger><ConditionGroup>
								<Condition name="before_1" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="13.0"><Position><WorldPosition x="52126.732" y="68188.735" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition>
								<Condition name="stopped_1" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><StandStillCondition duration="3" /></EntityCondition></ByEntityCondition></Condition>
							</ConditionGroup></StartTrigger>
						</Event>
						<Event name="red_1_run" priority="parallel" maximumExecutionCount="1">
							<Action name="ran_red_1"><UserDefinedAction><CustomCommandAction type="exitFailure" /></UserDefinedAction></Action>
							<StartTrigger><ConditionGroup>
								<Condition name="beyond_1" delay="0" conditionEdge="none"><ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any"><EntityRef entityRef="ego" /></TriggeringEntities><EntityCondition><ReachPositionCondition tolerance="8.0"><Position><WorldPosition x="52129.451" y="68202.468" z="0.0" h="0" p="0" r="0" /></Position></ReachPositionCondition></EntityCondition></ByEntityCondition></Condition>
								<Condition name="still_red_1" delay="0" conditionEdge="none"><ByValueCondition><ParameterCondition parameterRef="red_1" value="1" rule="equalTo" /></ByValueCondition></Condition>
							</ConditionGroup></StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
