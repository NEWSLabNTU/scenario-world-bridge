<?xml version="1.0"?>
<OpenSCENARIO>
	<FileHeader author="scenario-world-bridge" date="2026-10-30T00:00:00+00:00" description="Roadmap 062 O6: a loop on the roads around NTU from public data, on Isaac. 椰林大道 west, right at the main gate onto 新生南路 north, right onto 辛亥路 east, back through the campus to 椰林大道 east, about 2.2 km. The light on 新生南路 at the second junction and the one for the right turn onto 辛亥路 start red and turn green once the ego has stopped for them; running either fails. Written by scripts/open_maps/scenario.py." revMajor="1" revMinor="2" />
	<ParameterDeclarations>
		<ParameterDeclaration name="red_0" parameterType="integer" value="1" />
		<ParameterDeclaration name="red_1" parameterType="integer" value="1" />
	</ParameterDeclarations>
	<CatalogLocations><VehicleCatalog><Directory path="$(find-pkg-share sim_vehicle_spec)/catalogs" /></VehicleCatalog></CatalogLocations>
	<RoadNetwork>
		<LogicFile filepath="$(env SWB_OPEN_MAPS)/ntu/map" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<CatalogReference catalogName="vehicles" entryName="tesla_model3">
				<ParameterAssignments>
					<ParameterAssignment parameterRef="maxSpeed" value="50" />
					<ParameterAssignment parameterRef="maxAcceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxDeceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxSteering" value="0.5" />
				</ParameterAssignments>
			</CatalogReference>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
