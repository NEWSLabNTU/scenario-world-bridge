									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="52174.62" y="68207.153" z="0.0" h="-0.009" p="0" r="0" /></Position></Waypoint>
									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="52265.341" y="67883.96" z="0.0" h="-1.561" p="0" r="0" /></Position></Waypoint>
									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="52359.619" y="67657.274" z="0.0" h="0.004" p="0" r="0" /></Position></Waypoint>
