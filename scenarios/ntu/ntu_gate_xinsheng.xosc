							</Position>
						</TeleportAction>
					</PrivateAction>
					<PrivateAction>
						<RoutingAction>
							<AcquirePositionAction><Position><WorldPosition x="52099.094" y="68040.426" z="0.0" h="1.375" p="0" r="0" /></Position></AcquirePositionAction>
