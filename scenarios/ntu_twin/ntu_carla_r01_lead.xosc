					<Dimensions width="2.0" height="1.6" length="4.5" />
				</BoundingBox>
				<Performance maxSpeed="20" maxAcceleration="3.0" maxDeceleration="8.0" />
				<Axles>
					<FrontAxle maxSteering="0.5" wheelDiameter="0.6" trackWidth="1.7" positionX="2.8" positionZ="0.3" />
