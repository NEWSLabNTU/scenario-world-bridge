							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="collision_lead" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
