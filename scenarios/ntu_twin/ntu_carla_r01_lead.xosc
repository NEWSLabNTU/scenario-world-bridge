									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<ManeuverGroup maximumExecutionCount="1" name="lead_leaves">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="lead" />
