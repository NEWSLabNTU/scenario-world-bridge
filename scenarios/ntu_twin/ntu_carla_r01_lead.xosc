					<PrivateAction>
						<RoutingAction>
							<AcquirePositionAction>
								<Position>
									<WorldPosition x="52578.0" y="67835.0" z="11.6" h="-1.5626" p="0" r="0" />
								</Position>
							</AcquirePositionAction>
						</RoutingAction>
					</PrivateAction>
				</Private>
				<Private entityRef="lead">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="52814.02" y="67840.28" z="12.3" h="1.5749" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
					<PrivateAction>
						<RoutingAction>
							<AcquirePositionAction>
								<Position>
									<WorldPosition x="52578.0" y="67835.0" z="11.6" h="-1.5626" p="0" r="0" />
								</Position>
							</AcquirePositionAction>
						</RoutingAction>
					</PrivateAction>
