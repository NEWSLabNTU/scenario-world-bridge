<!--
	Roadmap 072 (CARLA): r01 on the NTU campus in CARLA behind a slower car. The lead starts 25 m ahead of the
	ego in its lane and drives r01 at $leadSpeed; it leaves (deleted) 45 m before the goal, at the
	last turn, so the ego can reach the goal. Positions are on r01's driven track (118, 2026-11-03).
	Success: the ego reaches the goal. Failure: the ego touches the lead, or 600 s pass.
-->
<OpenSCENARIO>
	<FileHeader author="scenario-world-bridge" date="2026-10-30T00:00:00+00:00" description="roadmap 072: route r01 on the NTU campus in CARLA 0.9.16 behind a slower car" revMajor="1" revMinor="2" />
	<ParameterDeclarations>
		<ParameterDeclaration name="leadSpeed" parameterType="double" value="2.5" />
