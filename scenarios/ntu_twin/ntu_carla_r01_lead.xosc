							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="lead_near_the_end" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="lead" />
											</TriggeringEntities>
											<EntityCondition>
												<ReachPositionCondition tolerance="3.0">
													<Position>
														<WorldPosition x="52600.13" y="67886.38" z="11.9" h="0" p="0" r="0" />
													</Position>
												</ReachPositionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
