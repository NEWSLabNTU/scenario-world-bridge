<?xml version="1.0"?>
<OpenSCENARIO>
	<FileHeader author="scensim" date="2026-11-20T00:00:00+00:00" description="Roadmap 056 step 5, 086 C4: a label's class for one scenario beside a road the car leaves. Town01's straight at y -130, heading west: the car leaves its lane to the right (north) at x 184, crosses the shoulder lane and the curb, and stops on the walkway beside it (Town01's sidewalk, raised 0.1 m: lanelet 7485, as SSv2 places waypoints on lanes only) at x 175.5, y -125.2, whose ground this scenario makes gravel (SideWalk) and wet mud (Terrain), friction only. The simple pilot drives straight through the waypoints (route:=direct), as Autoware never leaves its lane. Clear of obstacles there in the map's point cloud (a fence at x 170, a pole at x 163.5). Isaac only (label classes are its surface layer's)" revMajor="1" revMinor="2" />
	<ParameterDeclarations>
		<ParameterDeclaration name="sidewalk_class" parameterType="string" value="gravel" />
		<ParameterDeclaration name="terrain_class" parameterType="string" value="mud_wet" />
	</ParameterDeclarations>
	<CatalogLocations><VehicleCatalog><Directory path="$(env SCENSIM_VEHICLES)" /></VehicleCatalog></CatalogLocations>
	<RoadNetwork>
		<LogicFile filepath="$(env SCENSIM_MAPS)/Town01" />
	</RoadNetwork>
	<Entities>
		<ScenarioObject name="ego">
			<CatalogReference catalogName="vehicles" entryName="tesla_model3">
				<ParameterAssignments>
					<ParameterAssignment parameterRef="maxSpeed" value="50" />
					<ParameterAssignment parameterRef="maxAcceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxDeceleration" value="15.0" />
					<ParameterAssignment parameterRef="maxSteering" value="0.5" />
				</ParameterAssignments>
			</CatalogReference>
			<ObjectController>
				<Controller name="Autoware">
					<Properties>
						<Property name="maxJerk" value="1.5" />
						<Property name="minJerk" value="-1.5" />
					</Properties>
				</Controller>
			</ObjectController>
		</ScenarioObject>
	</Entities>
	<Storyboard>
		<Init>
			<Actions>
				<GlobalAction>
					<EnvironmentAction>
						<Environment name="verge">
							<RoadCondition frictionScaleFactor="1.0" wetness="dry">
								<Properties>
									<Property name="scensim.default.SideWalk" value="$sidewalk_class" />
									<Property name="scensim.default.Terrain" value="$terrain_class" />
								</Properties>
							</RoadCondition>
						</Environment>
					</EnvironmentAction>
				</GlobalAction>
				<Private entityRef="ego">
					<PrivateAction>
						<TeleportAction>
							<Position>
								<WorldPosition x="200.0" y="-129.5" z="0.3" h="3.14159" p="0" r="0" />
							</Position>
						</TeleportAction>
					</PrivateAction>
					<PrivateAction>
						<RoutingAction>
							<AssignRouteAction>
								<Route name="off_the_road" closed="false">
									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="186.0" y="-129.5" z="0.0" h="3.14159" p="0" r="0" /></Position></Waypoint>
									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="180.5" y="-125.2" z="0.1" h="3.14159" p="0" r="0" /></Position></Waypoint>
									<Waypoint routeStrategy="shortest"><Position><WorldPosition x="175.5" y="-125.2" z="0.1" h="3.14159" p="0" r="0" /></Position></Waypoint>
								</Route>
							</AssignRouteAction>
						</RoutingAction>
					</PrivateAction>
				</Private>
			</Actions>
		</Init>
		<Story name="verge">
			<Act name="verge_act">
				<ManeuverGroup maximumExecutionCount="1" name="ego_maneuvers">
					<Actors selectTriggeringEntities="false">
						<EntityRef entityRef="ego" />
					</Actors>
					<Maneuver name="end_conditions">
						<Event name="success" priority="parallel">
							<Action name="exit_success">
								<UserDefinedAction>
									<CustomCommandAction type="exitSuccess" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="on_the_verge" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
												<ReachPositionCondition tolerance="1.5">
													<Position>
														<WorldPosition x="175.5" y="-125.2" z="0.1" h="3.14159" p="0" r="0" />
													</Position>
												</ReachPositionCondition>
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
									<Condition name="stopped" delay="0" conditionEdge="none">
										<ByEntityCondition>
											<TriggeringEntities triggeringEntitiesRule="any">
												<EntityRef entityRef="ego" />
											</TriggeringEntities>
											<EntityCondition>
												<SpeedCondition value="0.1" rule="lessThan" />
											</EntityCondition>
										</ByEntityCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
						<Event name="timeout" priority="parallel">
							<Action name="exit_failure">
								<UserDefinedAction>
									<CustomCommandAction type="exitFailure" />
								</UserDefinedAction>
							</Action>
							<StartTrigger>
								<ConditionGroup>
									<Condition name="too_long" delay="0" conditionEdge="none">
										<ByValueCondition>
											<SimulationTimeCondition value="90" rule="greaterThan" />
										</ByValueCondition>
									</Condition>
								</ConditionGroup>
							</StartTrigger>
						</Event>
					</Maneuver>
				</ManeuverGroup>
				<StartTrigger>
					<ConditionGroup>
						<Condition name="start" delay="0" conditionEdge="none">
							<ByValueCondition>
								<SimulationTimeCondition value="0" rule="greaterThan" />
							</ByValueCondition>
						</Condition>
					</ConditionGroup>
				</StartTrigger>
			</Act>
		</Story>
		<StopTrigger />
	</Storyboard>
</OpenSCENARIO>
