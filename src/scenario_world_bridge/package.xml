<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scenario_world_bridge</name>
  <version>0.1.0</version>
  <description>SSv2 ZMQ+Protobuf backend adapter for CARLA simulator</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- System libraries the build needs (installed by rosdep install): libclang for
       carla-rust's autocxx bindings, protoc for prost-build (SSv2's .proto files), libzmq
       for the zmq crate (SSv2's simulation_interface transport). -->
  <build_depend>libclang-dev</build_depend>
  <build_depend>protobuf-dev</build_depend>
  <depend>libzmq3-dev</depend>

  <!-- The weather world services (rclrs node). rclrs itself is a crate, not a rosdep key. -->
  <depend>rcl</depend>
  <depend>scensim_interfaces</depend>
  <!-- rclrs 0.7 builds its vendored example_interfaces and test_msgs from the installed ROS
       packages: Autoware 1.5.0's install has them, the 2.0.0 image does not. -->
  <build_depend>example_interfaces</build_depend>
  <build_depend>test_msgs</build_depend>

  <export>
    <build_type>ament_cargo</build_type>
  </export>
</package>
