<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim</name>
  <version>0.1.0</version>
  <description>
    scensim's user commands: `ros2 run scensim project|assets|seat|run|runs`.
    Projects (testbench.yaml), assets fetched by name into a read-only cache with a lock file,
    seats (a stack's share of a host) from config files, runs and suites against a
    long-lived stack, and their results.
  </description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- a suite's sample: and run --replay (roadmap 092 K3) -->
  <exec_depend>scensim_sampler</exec_depend>
  <!-- scensim.load_map: the keeper asks the bridge to load a map's town on a CARLA map switch -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>scensim_interfaces</exec_depend>
  <!-- scensim assets fetch: the Hugging Face Hub datasets -->
  <exec_depend>python3-huggingface-hub-pip</exec_depend>
  <exec_depend>openscenario_interpreter_msgs</exec_depend>
  <exec_depend>scensim_agent</exec_depend>
  <exec_depend>sim_vehicle_ecu</exec_depend>
  <!-- optional: huggingface_hub (pip), used by `assets fetch` when importable;
       without it the Hub is reached over plain HTTPS with the standard library -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
