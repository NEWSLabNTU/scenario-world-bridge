<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_agent</name>
  <version>0.1.0</version>
  <description>
    The agent SDK (roadmap 030): one Python interface, scensim_agent.Agent, for any autopilot
    driving scensim scenarios through the agent relay, and the agent
    protocol both ends import. Standard library only; ROS optional.
  </description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <!-- Only scensim_agent.ros and ros_adapter use ROS; the SDK core is standard library. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <!-- CARLA's agents package (the carla_basic adapter) imports both -->
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <!-- simple_pilot: routes on the lanelet2 map, drives Autoware's vehicle interface -->
  <exec_depend>lanelet2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>autoware_control_msgs</exec_depend>
  <exec_depend>autoware_vehicle_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>autoware_adapi_v1_msgs</exec_depend>
  <exec_depend>autoware_internal_debug_msgs</exec_depend>
  <exec_depend>tier4_external_api_msgs</exec_depend>
  <exec_depend>tier4_rtc_msgs</exec_depend>
  <exec_depend>sim_vehicle_spec</exec_depend>
  <!-- the carla_basic adapter also needs the CARLA Python API (pip install carla==0.9.16), not a rosdep key -->

  <test_depend>python3-pytest</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
