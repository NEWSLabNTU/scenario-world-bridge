<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_examples</name>
  <version>0.1.0</version>
  <description>Starter scenarios and working example projects for scenario-world-bridge: this project's Town01/Town02 scenarios, AWF ODD use cases, and projects for `ros2 run scensim`</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>scensim_launch</exec_depend>
  <!-- the vehicle catalog the scenarios refer to: $(find-pkg-share sim_vehicle_spec)/catalogs -->
  <exec_depend>sim_vehicle_spec</exec_depend>
  <!-- the example projects: `ros2 run scensim project|assets|run`, and multi_pilot's own agent -->
  <exec_depend>scensim</exec_depend>
  <exec_depend>scensim_agent</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
