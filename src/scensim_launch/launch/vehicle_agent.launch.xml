<?xml version="1.0" encoding="UTF-8"?>
<!-- The vehicle agent beside a vehicle side (roadmaps 017, 051): scensim_agent's vehicle_agent
     takes goals from the scenario's agent relay and drives Autoware's API locally, so the
     scenario needs no access to this ROS domain. With no relay and a goal_poses_file it drives
     to that goal instead.

     It is passed to a vehicle bridge's launch (acb_launch carla_simulator.launch.xml, aib_launch
     isaac_simulator.launch.xml) as extra_launch, which the Autoware profile includes with
     map_path and use_sim_time; relay, entity, goal_poses_file and agent_config are read from
     the command line (launch arguments are global). The profile includes one extra_launch, so a
     launch file of the user's own comes in as user_launch and is included here. -->
<launch>
  <!-- One DDS transport for every process of a run (roadmap 070, frictions 8 and 14): Cyclone
       with the workspace's localhost profile, unless the environment already names others.
       Fast DDS (an unset RMW) ignores the profile and cannot see the Cyclone processes, and on
       hosts without loopback multicast Cyclone's default discovery misses peers. -->
  <arg name="dds_config" default="$(env CYCLONEDDS_URI file://$(find-pkg-share scensim_launch)/config/cyclonedds-localhost.xml)" description="CYCLONEDDS_URI for every process this launch starts (default: the environment's, else scensim_launch's localhost profile)"/>
  <set_env name="CYCLONEDDS_URI" value="$(var dds_config)"/>
  <set_env name="RMW_IMPLEMENTATION" value="$(env RMW_IMPLEMENTATION rmw_cyclonedds_cpp)"/>
  <arg name="map_path" default=""/>
  <arg name="use_sim_time" default="true"/>
  <arg name="relay" default="" description="tcp://host:port of the scenario's agent relay; empty = no relay"/>
  <arg name="entity" default="ego" description="the scenario entity this vehicle is"/>
  <arg name="goal_poses_file" default="" description="local goal(s) when there is no relay; empty = none"/>
  <arg name="agent_config" default="" description="YAML/JSON of the agent's settings (scensim_agent AutowareAgent DEFAULTS: converge_timeout, ready_timeout, scan_wait, ...); empty = defaults"/>
  <arg name="vehicle_model" default="none" description="Autoware's vehicle model (the profile's): its description's spec_hash.yaml is the spec the agent registers with; none = no spec_hash (not empty: rcl refuses an empty parameter)"/>
  <arg name="spec_hash_file" default="" description="a YAML with key spec_hash the agent registers with, instead of vehicle_model's description package (a car from another repository); empty = vehicle_model's"/>
  <arg name="user_launch" default="" description="a launch file of your own to start beside this vehicle side; empty = none"/>
  <!-- The conflict-zone protocol (roadmap 078 I4): czp's interaction_strategy node beside
       Autoware, in this (the ego's) domain. Off by default; on, it puts the RTC modules it drives
       in manual mode only while it holds a decision that is not stock's. -->
  <arg name="interaction_strategy" default="false" description="true: run czp's interaction_strategy node"/>
  <arg name="interaction_strategy_zones" default="" description="czp-zones' zones.yaml for this map; empty = map_path/czp_zones.yaml, else built from the map"/>
  <arg name="interaction_strategy_modules" default="[intersection]" description="the RTC modules the node drives"/>
  <arg name="interaction_strategy_log" default="" description="a file for the decision records (JSON lines); empty = topic only"/>

  <!-- Two node blocks: relay mode (respawned; registers with the relay) and local mode
       (drives once to goal_poses_file's goal, then exits). -->
  <node pkg="scensim_agent" exec="vehicle_agent" name="vehicle_agent" output="screen" respawn="true"
        if="$(eval '&quot;$(var relay)&quot; != &quot;&quot;')">
    <param name="relay" value="$(var relay)"/>
    <param name="entity" value="$(var entity)"/>
    <param name="agent_config" value="$(var agent_config)"/>
    <param name="vehicle_model" value="$(var vehicle_model)"/>
    <param name="spec_hash_file" value="$(var spec_hash_file)"/>
  </node>
  <node pkg="scensim_agent" exec="vehicle_agent" name="vehicle_agent" output="screen"
        if="$(eval '&quot;$(var relay)&quot; == &quot;&quot; and &quot;$(var goal_poses_file)&quot; != &quot;&quot;')">
    <param name="goal_poses_file" value="$(var goal_poses_file)"/>
    <param name="agent_config" value="$(var agent_config)"/>
  </node>

  <node pkg="czp" exec="interaction_strategy" name="interaction_strategy" output="screen"
        if="$(var interaction_strategy)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="map_path" value="$(eval &quot;'$(var map_path)' if '$(var map_path)' != '' else 'none'&quot;)"/>
    <param name="zones_file" value="$(eval &quot;'$(var interaction_strategy_zones)' if '$(var interaction_strategy_zones)' != '' else 'none'&quot;)"/>
    <param name="modules" value="$(var interaction_strategy_modules)"/>
    <param name="record_log" value="$(eval &quot;'$(var interaction_strategy_log)' if '$(var interaction_strategy_log)' != '' else 'none'&quot;)"/>
  </node>
  <!-- Its watchdog: the driven modules back to auto mode when the node's heartbeat stops (it died or hung
       while holding a module in manual mode). A separate process, so it outlives the node. -->
  <node pkg="czp" exec="interaction_strategy_watchdog" name="interaction_strategy_watchdog" output="screen"
        respawn="true" if="$(var interaction_strategy)">
    <param name="modules" value="$(var interaction_strategy_modules)"/>
  </node>

  <group if="$(eval '&quot;$(var user_launch)&quot; != &quot;&quot;')">
    <include file="$(var user_launch)">
      <arg name="map_path" value="$(var map_path)"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </group>
</launch>
