<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_launch</name>
  <version>0.1.0</version>
  <description>Launch files for scensim demos</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The simulation side only. The vehicle side (acb_launch, aib_launch, autoware_sim_profile,
       acb_bridge: Autoware) is named by the launches at run time (ego_launch, the pilots) and is
       not a dependency here, so a host without Autoware resolves this package with rosdep;
       the vehicle packages declare their own dependencies. -->
  <exec_depend>scenario_world_bridge</exec_depend>
  <exec_depend>scenario_agent_relay</exec_depend>
  <exec_depend>scensim_agent</exec_depend>
  <!-- vehicle_agent.launch.xml: interaction_strategy:=true (roadmap 078) -->
  <exec_depend>czp</exec_depend>
  <!-- scensim.launch.py: the project, seat and pilots plan (scensim.stack) -->
  <exec_depend>scensim</exec_depend>
  <!-- every launch here runs on Cyclone DDS (config/cyclonedds-localhost.xml), which a stock
       ROS 2 Humble install may lack: declared so rosdep installs it (roadmap 079, step 6) -->
  <exec_depend>rmw_cyclonedds_cpp</exec_depend>
  <exec_depend>scenario_test_runner</exec_depend>
  <!-- stack.launch.py: the world servers and the vehicle catalog -->
  <exec_depend>scensim_carla_world</exec_depend>
  <exec_depend>scensim_isaac_world</exec_depend>
  <exec_depend>sim_vehicle_spec</exec_depend>
  <!-- chase_view (demo camera window); it also needs the CARLA Python API: pip install carla==0.9.16 -->
  <exec_depend>python3-pygame</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- demo_captions -->
  <exec_depend>openscenario_interpreter_msgs</exec_depend>
  <exec_depend>traffic_simulator_msgs</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
