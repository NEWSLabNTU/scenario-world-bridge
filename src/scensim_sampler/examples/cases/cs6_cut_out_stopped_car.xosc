<?xml version="1.0" encoding="UTF-8"?>
<!-- CS6 of docs/design/scenario-description.md (a fresh case study, 093 D7): on a highway the lead
     car changes lane late and reveals a car stopped in the ego's lane. Values invented; an example
     for `scensim-sample compilable` (docs/design/compilable-subset.md), not a tuned scenario. -->
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="3" date="2026-11-21T00:00:00" author="scensim"
              description="a lead car's cut-out reveals a stopped car">
    <Properties>
      <Property name="scensim.category" value="R1.lead_cut_out.stopped_vehicle"/>
      <Property name="scensim.cell_attributes" value="illumination,stopped_kind"/>
    </Properties>
  </FileHeader>
  <ParameterDeclarations>
    <ParameterDeclaration name="ego_speed" parameterType="double" value="27"/>
    <ParameterDeclaration name="ego_headway_m" parameterType="double" value="40"/>
    <ParameterDeclaration name="reveal_m" parameterType="double" value="55"/>
    <ParameterDeclaration name="lc_time" parameterType="double" value="2.5"/>
    <!-- the base's own variables, which only derived values read (time_headway gives
         ego_headway_m and lead_s, reveal_time gives reveal_m): declared so a record keeps them -->
    <ParameterDeclaration name="time_headway" parameterType="double" value="1.5"/>
    <ParameterDeclaration name="reveal_time" parameterType="double" value="2.0"/>
    <ParameterDeclaration name="stopped_s" parameterType="double" value="600"/>
    <ParameterDeclaration name="ego_s" parameterType="double" value="5"/>
    <ParameterDeclaration name="lead_s" parameterType="double" value="45"/>
    <ParameterDeclaration name="stopped_kind" parameterType="string" value="car"/>
    <ParameterDeclaration name="world.illumination" parameterType="string" value="day"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork><LogicFile filepath="maps/highway_3lane"/></RoadNetwork>
  <Entities>
    <ScenarioObject name="ego">
      <Vehicle name="car" vehicleCategory="car"><Properties/></Vehicle>
      <ObjectController><Controller name="ego"><Properties>
        <Property name="isEgo" value="true"/></Properties></Controller></ObjectController>
    </ScenarioObject>
    <!-- the lead keeps its speed to the cut-out: blind (SSv2's isBlind), so its default
         behaviour does not brake for the stopped car first -->
    <ScenarioObject name="lead">
      <Vehicle name="car" vehicleCategory="car"><Properties/></Vehicle>
      <ObjectController><Controller name="lead"><Properties>
        <Property name="isBlind" value="true"/></Properties></Controller></ObjectController>
    </ScenarioObject>
    <!-- stopped: held at 0 by its Init SpeedAction; OpenSCENARIO has no "parked vehicle".
         Its category is the sample's (car, truck, motorbike) -->
    <ScenarioObject name="stopped">
      <Vehicle name="stopped_vehicle" vehicleCategory="$stopped_kind"><Properties/></Vehicle>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init><Actions>
      <Private entityRef="ego"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="hwy_right" s="$ego_s" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$ego_speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction></Private>
      <Private entityRef="lead"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="hwy_right" s="$lead_s" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="$ego_speed"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction></Private>
      <Private entityRef="stopped"><PrivateAction><TeleportAction><Position>
        <LanePosition roadId="" laneId="hwy_right" s="$stopped_s" offset="0"/></Position></TeleportAction></PrivateAction>
        <PrivateAction><LongitudinalAction><SpeedAction>
          <SpeedActionDynamics dynamicsShape="step" value="0" dynamicsDimension="time"/>
          <SpeedActionTarget><AbsoluteTargetSpeed value="0"/></SpeedActionTarget>
        </SpeedAction></LongitudinalAction></PrivateAction></Private>
    </Actions></Init>
    <Story name="main"><Act name="act">
      <ManeuverGroup name="cut_out" maximumExecutionCount="1">
        <Actors selectTriggeringEntities="false"><EntityRef entityRef="lead"/></Actors>
        <Maneuver name="cut_out"><Event name="cut_out" priority="override" maximumExecutionCount="1">
          <Action name="cut_out"><PrivateAction><LateralAction><LaneChangeAction>
            <LaneChangeActionDynamics dynamicsShape="sinusoidal" value="$lc_time" dynamicsDimension="time"/>
            <LaneChangeTarget><RelativeTargetLane entityRef="lead" value="1"/></LaneChangeTarget>
          </LaneChangeAction></LateralAction></PrivateAction></Action>
          <!-- the lead leaves its lane when the stopped car is reveal_m ahead of it, bumper to
               bumper (reveal_m is the sampler's: lead speed x the time it leaves, derived) -->
          <StartTrigger><ConditionGroup><Condition name="reveal" delay="0" conditionEdge="rising">
            <ByEntityCondition><TriggeringEntities triggeringEntitiesRule="any">
              <EntityRef entityRef="lead"/></TriggeringEntities><EntityCondition>
              <RelativeDistanceCondition entityRef="stopped" relativeDistanceType="longitudinal"
                  coordinateSystem="lane" freespace="true" value="$reveal_m" rule="lessThan"/>
            </EntityCondition></ByEntityCondition>
          </Condition></ConditionGroup></StartTrigger>
        </Event></Maneuver>
      </ManeuverGroup>
      <StartTrigger><ConditionGroup><Condition name="t0" delay="0" conditionEdge="none">
        <ByValueCondition><SimulationTimeCondition value="0" rule="greaterThan"/></ByValueCondition>
      </Condition></ConditionGroup></StartTrigger>
    </Act></Story>
    <StopTrigger><ConditionGroup><Condition name="end" delay="0" conditionEdge="none">
      <ByValueCondition><SimulationTimeCondition value="40" rule="greaterThan"/></ByValueCondition>
    </Condition></ConditionGroup></StopTrigger>
  </Storyboard>
</OpenSCENARIO>
