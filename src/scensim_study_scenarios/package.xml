<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>scensim_study_scenarios</name>
  <version>0.1.0</version>
  <description>The scensim studies' shared scenarios: the frame-budget benchmark (bench/) and the gap reproducers (gap/), named by the study testbenches as pkg://scensim_study_scenarios/...</description>
  <maintainer email="jerry73204@gmail.com">aeon</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- the vehicle catalog the scenarios refer to: $(env SCENSIM_VEHICLES), sim_vehicle_spec's catalogs for the simulator's body -->
  <exec_depend>sim_vehicle_spec</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
