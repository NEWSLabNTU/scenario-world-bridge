<?xml version="1.0" encoding="UTF-8"?>
<!--
  The whole stack on CARLA (roadmap 073): stack.launch.py with sim:=carla and the CARLA world
  server's arguments of its own. CARLA itself runs apart and long-lived (`just carla-start`),
  always synchronous under swb: the world server steps it, frame by frame.

    play_launch launch swb_launch carla.launch.xml map_path:=<map dir> \
        [vehicle_physics:=<carla_physics.yaml>|none] [npc_contact_sensors:=false] \
        [ego_launch:=<path>|'<package> <file>'] [ego_launch_args:='a:=1 b:=2'] \
        [vehicle_model:=...] [spec_hash_file:=...] [vehicle_catalogs:=...] \
        [scenario:=<path to .xosc>] [scenario_args:='...'] [exit_on_scenario_end:=false]

  Host settings (CARLA_HOST, CARLA_PORT, WORLD_PORT, ports, domains) are the environment's:
  stack.launch.py.
-->
<launch>
  <arg name="vehicle_physics" default="none" description="the vehicle spec's carla_physics.yaml on the ego and agent vehicles; none: the blueprints' own"/>
  <arg name="npc_contact_sensors" default=""/>
  <arg name="map_path" default="" description="the default autopilot's map directory"/>
  <arg name="ego_launch" default="" description="the autopilot's launch; empty: acb's Autoware profile; none: no ego"/>
  <arg name="ego_launch_args" default=""/>
  <arg name="agent" default="true"/>
  <arg name="vehicle_model" default=""/>
  <arg name="spec_hash_file" default=""/>
  <arg name="vehicle_catalogs" default=""/>
  <arg name="side_args" default="" description="name:=value ... for the simulation side (simulation.launch.xml: config_file, weather, gap_trace_dir, npc_motion, contact_report_dir)"/>
  <arg name="scenario" default=""/>
  <arg name="scenario_args" default=""/>
  <arg name="exit_on_scenario_end" default="false"/>
  <arg name="spawn" default=""/>

  <include file="$(find-pkg-share swb_launch)/launch/stack.launch.py">
    <arg name="sim" value="carla"/>
    <arg name="sim_args" value="vehicle_physics:=$(var vehicle_physics) npc_contact_sensors:=$(var npc_contact_sensors)"/>
    <arg name="map_path" value="$(var map_path)"/>
    <arg name="ego_launch" value="$(var ego_launch)"/>
    <arg name="ego_launch_args" value="$(var ego_launch_args)"/>
    <arg name="agent" value="$(var agent)"/>
    <arg name="vehicle_model" value="$(var vehicle_model)"/>
    <arg name="spec_hash_file" value="$(var spec_hash_file)"/>
    <arg name="vehicle_catalogs" value="$(var vehicle_catalogs)"/>
    <arg name="side_args" value="$(var side_args)"/>
    <arg name="scenario" value="$(var scenario)"/>
    <arg name="scenario_args" value="$(var scenario_args)"/>
    <arg name="exit_on_scenario_end" value="$(var exit_on_scenario_end)"/>
    <arg name="spawn" value="$(var spawn)"/>
  </include>
</launch>
