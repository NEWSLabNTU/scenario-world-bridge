<?xml version="1.0" encoding="UTF-8"?>
<!--
  The simulation side on Isaac Sim (roadmap 046): the scenario bridge driving the Isaac world
  server, and the agent relay. The world server is its own long-lived launch
  (swb_isaac_world.launch.xml, `just isaac-world`): its start preloads worlds for minutes, so it
  is not restarted with the simulation side.

    play_launch launch FLAGS swb_launch isaac_simulation.launch.xml [isaac_port:=5590]
        [ssv2_port:=5555] [agent_port:=5560] [world_render:=true] [gap_trace_dir:=DIR]
-->
<launch>
  <!-- One DDS transport for every process of a run (roadmap 070, frictions 8 and 14): Cyclone
       with the workspace's localhost profile, unless the environment already names others.
       Fast DDS (an unset RMW) ignores the profile and cannot see the Cyclone processes, and on
       hosts without loopback multicast Cyclone's default discovery misses peers. -->
  <arg name="dds_config" default="$(env CYCLONEDDS_URI file://$(find-pkg-share swb_launch)/config/cyclonedds-localhost.xml)" description="CYCLONEDDS_URI for every process this launch starts (default: the environment's, else swb_launch's localhost profile)"/>
  <set_env name="CYCLONEDDS_URI" value="$(var dds_config)"/>
  <set_env name="RMW_IMPLEMENTATION" value="$(env RMW_IMPLEMENTATION rmw_cyclonedds_cpp)"/>
  <arg name="isaac_port" default="5590" description="the Isaac world server's port on 127.0.0.1"/>
  <arg name="world_render" default=""/>
  <arg name="world_request_timeout_seconds" default=""/>
  <arg name="world_load_timeout_seconds" default=""/>
  <arg name="config_file" default="$(find-pkg-share scenario_world_bridge)/config/bridge_config.yaml"/>
  <arg name="ssv2_port" default=""/>
  <arg name="entity" default="ego"/>
  <arg name="agent_port" default="5560"/>
  <arg name="npc_motion" default=""/>
  <arg name="weather" default=""/>
  <arg name="gap_trace_dir" default=""/>
  <arg name="contact_report_dir" default=""/>

  <include file="$(find-pkg-share swb_launch)/launch/simulation.launch.xml">
    <arg name="world_endpoint" value="tcp://127.0.0.1:$(var isaac_port)"/>
    <arg name="world_render" value="$(var world_render)"/>
    <arg name="world_request_timeout_seconds" value="$(var world_request_timeout_seconds)"/>
    <arg name="world_load_timeout_seconds" value="$(var world_load_timeout_seconds)"/>
    <arg name="config_file" value="$(var config_file)"/>
    <arg name="ssv2_port" value="$(var ssv2_port)"/>
    <arg name="entity" value="$(var entity)"/>
    <arg name="agent_port" value="$(var agent_port)"/>
    <arg name="npc_motion" value="$(var npc_motion)"/>
    <arg name="weather" value="$(var weather)"/>
    <arg name="gap_trace_dir" value="$(var gap_trace_dir)"/>
    <arg name="contact_report_dir" value="$(var contact_report_dir)"/>
  </include>
</launch>
